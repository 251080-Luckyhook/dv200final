{
  "name": "ngwana-huis",
  "version": "1.0.0",
  "private": true,
  "description": "Ngwana Huis volunteer visit booking platform (React + Vite, Express, MongoDB Atlas)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node backend/index.js",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:frontend\"",
    "dev:server": "nodemon backend/index.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "migrate": "node backend/migrate.js",
    "heroku-postbuild": "npm ci --prefix frontend --include=dev && npm run build --prefix frontend"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.11.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.21.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4"
  }
}
